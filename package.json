{
    "name": "tray-app",
    "productName": "Network Map Tray",
    "version": "1.2.0",
    "description": "Electron tray application for network map monitoring",
    "main": "src/main/main.js",
    "scripts": {
        "start": "electron .",
        "check": "node --check src/main/main.js && node --check src/main/preload.cjs && node --check src/renderer/settings.js && node --check scripts/release.cjs && node --check scripts/stage-installer.cjs && node --check tests/electron-smoke.cjs",
        "test": "node --test tests/app.test.cjs",
        "test:electron": "electron tests/electron-smoke.cjs",
        "package": "npm run package:raw && npm run package:installer",
        "package:raw": "electron-packager . network-map-tray --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --no-asar --ignore=\"^/(?!src(?:/|$)|node_modules(?:/|$)|package\\.json$)|^/src/config/local\\.json$|^/node_modules/\\.cache(/|$)\"",
        "package:installer": "electron-builder --win nsis --x64 --publish never && npm run stage:installer",
        "stage:installer": "node scripts/stage-installer.cjs",
        "release:prepare": "node scripts/release.cjs prepare",
        "release:verify": "node scripts/release.cjs verify",
        "release:notes": "node scripts/release.cjs notes"
    },
    "author": "Rusty Dahlin",
    "license": "MIT",
    "engines": {
        "node": ">=22.12.0"
    },
    "dependencies": {
        "electron-updater": "^6.8.0",
        "node-fetch": "^3.3.2",
        "sound-play": "^1.1.0",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@electron/packager": "^20.3.0",
        "electron": "45.2.3",
        "electron-builder": "^26.0.0",
        "semver": "^7.7.3"
    },
    "overrides": {
        "glob@>=9.0.0 <14.0.2": "^14.0.3",
        "minimatch@>=7.0.0 <11.0.1": "^11.0.4"
    },
    "build": {
        "appId": "com.rustydahlin.networkmaptray",
        "asar": false,
        "directories": {
            "output": "dist/release"
        },
        "files": [
            "src/**/*",
            "!src/config/local.json",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "executableName": "network-map-tray"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "runAfterFinish": true,
            "deleteAppDataOnUninstall": false,
            "artifactName": "Network-Map-Tray-Setup-${version}.${ext}"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "rustydahlin",
                "repo": "networkmap-tray-app",
                "releaseType": "release"
            }
        ]
    },
    "allowScripts": {
        "electron@45.2.3": true
    }
}
