{
    "name": "tray-app",
    "productName": "Network Map Tray",
    "version": "1.0.0",
    "description": "Electron tray application for network map monitoring",
    "main": "src/main/main.js",
    "scripts": {
        "start": "electron .",
        "check": "node --check src/main/main.js && node --check scripts/release.cjs && node --check scripts/stage-installer.cjs",
        "test": "node --test tests/app.test.cjs",
        "package": "npm run package:raw && npm run package:installer",
        "package:raw": "electron-packager . network-map-tray --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=\"^/(?!src(?:/|$)|node_modules(?:/|$)|package\\.json$)|^/src/config/local\\.json$|^/node_modules/\\.cache(/|$)\"",
        "package:installer": "electron-builder --win nsis --x64 --publish never && npm run stage:installer",
        "stage:installer": "node scripts/stage-installer.cjs",
        "release:prepare": "node scripts/release.cjs prepare",
        "release:verify": "node scripts/release.cjs verify",
        "release:notes": "node scripts/release.cjs notes"
    },
    "author": "Rusty Dahlin",
    "license": "MIT",
    "dependencies": {
        "electron-updater": "^6.8.0",
        "electron-store": "^8.1.0",
        "node-fetch": "^3.3.2",
        "sound-play": "^1.1.0",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "electron": "^26.0.0",
        "electron-builder": "^26.0.0",
        "electron-packager": "^17.1.0",
        "semver": "^7.7.3"
    },
    "build": {
        "appId": "com.rustydahlin.networkmaptray",
        "asar": false,
        "directories": {
            "output": "dist/release"
        },
        "files": [
            "src/**/*",
            "!src/config/local.json",
            "package.json"
        ],
        "win": {
            "target": [{ "target": "nsis", "arch": ["x64"] }],
            "executableName": "network-map-tray"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "runAfterFinish": true,
            "deleteAppDataOnUninstall": false,
            "artifactName": "Network-Map-Tray-Setup-${version}.${ext}"
        },
        "publish": [{
            "provider": "github",
            "owner": "rustydahlin",
            "repo": "networkmap-tray-app",
            "releaseType": "release"
        }]
    },
    "allowScripts": {
        "electron@26.6.10": true
    }
}
